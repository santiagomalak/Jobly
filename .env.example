# ============ DISCORD ============
# Server Settings > Integrations > Webhooks > New Webhook (uno por canal)
DISCORD_WEBHOOK_RADAR=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_PROPUESTAS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_ERRORES=https://discord.com/api/webhooks/xxx/yyy

# ============ LLM — CASCADA GRATIS ============
# Nivel 1: Groq (gratis, rapidísimo). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Nivel 2: OpenRouter, modelos :free. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Nivel 3: Ollama local (100% offline). Dejá OLLAMA_MODEL vacío para saltearlo.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Nivel 4: plantilla sin IA. Siempre activo, no requiere configuración.
