# ============ DISCORD ============
# Server Settings > Integrations > Webhooks > New Webhook (uno por canal)
DISCORD_WEBHOOK_RADAR=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_PROPUESTAS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_ERRORES=https://discord.com/api/webhooks/xxx/yyy

# ============ LLM — CASCADA GRATIS ============
# Nivel 1: Groq (gratis, rapidísimo). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Nivel 2: OpenRouter, modelos :free. https://openrouter.ai/keys
# Los modelos :free rotan seguido — si este deja de andar, revisar cuáles
# están vivos con: GET https://openrouter.ai/api/v1/models (filtrar por ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Nivel 3: Ollama local (100% offline). Dejá OLLAMA_MODEL vacío para saltearlo.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Nivel 4: plantilla sin IA. Siempre activo, no requiere configuración.

# ============ CRM WEB (Vercel) ============
# Contraseña de entrada al CRM. Si no está, la app NO responde (falla cerrada). Usá una larga.
JOBLY_PASSWORD=
# Base compartida entre el cron (GitHub Actions) y el CRM web. https://turso.tech
# Sin estas dos, todo funciona igual con SQLite local (solo para uso en tu PC).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Recomendado en Vercel: corta las llamadas lentas a los LLM (segundos por proveedor)
LLM_TIMEOUT=15
